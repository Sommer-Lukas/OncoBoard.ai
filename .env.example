# Copy to .env and fill in. Never commit .env.

# Google Gemini
GEMINI_API_KEY=
GEMINI_MOCK=0
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_MODEL_VISION=gemini-2.5-pro

# Database
DB_PATH=./oncoboard.db

# Extracted TCGA MRI/SVS image patches. App boots fine if this is absent;
# /images is mounted and image endpoints return data only once it exists.
IMAGES_DIR=data/raw/MRI_and_SVS_Patches

# Logging
LOG_LEVEL=info

# External APIs
CLINICALTRIALS_BASE_URL=https://clinicaltrials.gov/api/v2
PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
